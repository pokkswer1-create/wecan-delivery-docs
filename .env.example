# 웹폼 접속 비밀번호 (폰에서 입력)
FORM_PIN=515050
PORT=3780

# 공개 URL (수신확인 링크용, Render면 서비스 주소)
# PUBLIC_URL=https://wecan-docs.onrender.com

# --- 이메일 ---
# 발신 주소 = 서비스 도메인 (Resend/Brevo/SendGrid에서 인증한 메일)
# 발신명 = 설정 화면의 상호
# 회신 = 설정 화면의 메일 (MAIL_REPLY_TO 쓰지 않음)
#
# 1) Resend: https://resend.com  → RESEND_API_KEY
# 2) Brevo:  https://www.brevo.com → BREVO_API_KEY
# 3) SendGrid → SENDGRID_API_KEY
# 4) 또는 SMTP (Gmail이면 발신 주소가 Gmail 계정으로 남을 수 있음)
#
# RESEND_API_KEY=
# BREVO_API_KEY=
# SENDGRID_API_KEY=
# MAIL_FROM=noreply@your-service-domain.com

# Gmail SMTP 예시 (앱 비밀번호 사용)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
