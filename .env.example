PORT=3780

# 공개 URL (수신확인 링크용, Render면 서비스 주소)
# PUBLIC_URL=https://wecan-docs.onrender.com

# --- 구글 로그인 + Gmail 발송 ---
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보
# OAuth 클라이언트 유형: 웹 애플리케이션
# 승인된 리디렉션 URI:
#   http://localhost:3780/auth/google/callback
#   https://wecan-docs.onrender.com/auth/google/callback
# Gmail API 사용 설정. 동의 화면은 테스트 사용자만 (gmail.send 검수 전)
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SESSION_SECRET=

# --- 설정·도장 유지 (Render 재시작 대비) ---
# 1) Render 디스크를 /var/data 에 붙이고:
# DATA_DIR=/var/data
# 2) 또는 Turso (무료 DB). URL·토큰은 브레인에 적지 말 것.
# WECAN_TURSO_URL=
# WECAN_TURSO_AUTH_TOKEN=

# --- 이메일 대체(구글 토큰이 없을 때만) ---
# 보낸 사람 표시명 = 설정 화면의 상호
# 보낸 사람 주소 = 로그인한 지메일 (구글 발송 시)
# 회신 = 설정 화면의 메일
#
# RESEND_API_KEY=
# BREVO_API_KEY=
# SENDGRID_API_KEY=
# MAIL_FROM=noreply@your-service-domain.com
